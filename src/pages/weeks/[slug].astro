---
import { getCollection, render, type CollectionEntry } from "astro:content";
import WeekLayout from "../../layouts/WeekLayout.astro";
import { listStudentVisibleWeeks } from "../../lib/weeks";

export async function getStaticPaths() {
  const allWeeks = await getCollection("weeks");
  const weeks = listStudentVisibleWeeks(allWeeks);

  return weeks.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, weeks },
  }));
}

interface Props {
  entry: CollectionEntry<"weeks">;
  weeks: CollectionEntry<"weeks">[];
}

const { entry, weeks } = Astro.props;
const { Content, headings } = await render(entry);

const currentPublishedIndex = weeks.findIndex((week) => week.id === entry.id);
const prev = currentPublishedIndex > 0 ? weeks[currentPublishedIndex - 1] : undefined;
const next =
  currentPublishedIndex >= 0 && currentPublishedIndex < weeks.length - 1
    ? weeks[currentPublishedIndex + 1]
    : undefined;
---

<WeekLayout entry={entry} headings={headings} prev={prev} next={next}>
  <Content />
</WeekLayout>
