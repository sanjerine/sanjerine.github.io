---
import { getCollection } from "astro:content";
import WeekCard from "../../components/WeekCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sortWeeks } from "../../lib/weeks";

const weeks = (await getCollection("weeks")).sort(sortWeeks);
---

<BaseLayout title="All Weeks | CITX0001 Workshop Hub" description="Browse every workshop week and release status.">
  <section class="rounded-3xl border border-slate-700/80 bg-slate-900/70 p-6 shadow-[0_18px_60px_-28px_rgba(15,23,42,0.8)] sm:p-8">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-200">Weekly index</p>
    <h1 class="mt-2 text-3xl font-bold text-white sm:text-4xl">All workshop weeks</h1>
    <p class="mt-3 max-w-2xl text-slate-200">
      Published weeks can be opened immediately. Unpublished weeks stay listed so students can see the upcoming structure.
    </p>
  </section>

  <section class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {weeks.map((entry) => <WeekCard entry={entry} />)}
  </section>
</BaseLayout>
