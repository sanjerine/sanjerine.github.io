---
import { getCollection } from "astro:content";
import WeekCard from "../../components/WeekCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { listStudentVisibleWeeks, weekLabel } from "../../lib/weeks";

const allWeeks = await getCollection("weeks");
const weeks = listStudentVisibleWeeks(allWeeks);
const firstWeek = weeks[0];
const currentWeek = weeks.at(-1);
---

<BaseLayout title="All Weeks | CITX0001 Workshop Hub" description="Browse every workshop week and release status.">
  <section class="surface-card-strong rounded-[1.9rem] p-6 sm:p-8">
    <p class="kicker">Workshop archive</p>
    <h1 class="mt-2 text-3xl font-bold sm:text-4xl">Published workshop weeks</h1>
    <p class="mt-3 max-w-2xl text-[var(--ink-soft)]">
      This list only shows released student content. The workshop sequence starts at Week 02.
    </p>

    <div class="mt-5 flex flex-wrap gap-2">
      {firstWeek && <span class="chip">Starts at {weekLabel(firstWeek)}</span>}
      {currentWeek && <span class="chip">Current release: {weekLabel(currentWeek)}</span>}
      <span class="chip">{weeks.length} published week(s)</span>
    </div>
  </section>

  {weeks.length > 0 ? (
    <section class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {weeks.map((entry) => <WeekCard entry={entry} />)}
    </section>
  ) : (
    <section class="surface-card mt-8 rounded-2xl p-5 text-sm text-[var(--ink-soft)]">
      No published workshops yet.
    </section>
  )}
</BaseLayout>
