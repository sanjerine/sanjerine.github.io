---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found | CITX0001 Workshop Hub" description="The requested page could not be found.">
  <section class="surface-card-strong rounded-3xl p-8 text-center">
    <p class="kicker">404</p>
    <h1 class="mt-2 text-3xl font-bold">Page not found</h1>
    <p class="mt-3 text-[var(--ink-soft)]">That route does not exist yet. Head back to the workshop archive.</p>
    <a href="/weeks/" class="btn-primary mt-5">View all weeks</a>
  </section>
</BaseLayout>
