---
import { getCollection } from "astro:content";
import WeekCard from "../components/WeekCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { listStudentVisibleWeeks, weekLabel } from "../lib/weeks";

const allWeeks = await getCollection("weeks");
const weeks = listStudentVisibleWeeks(allWeeks);
const firstWeek = weeks[0];
---

<BaseLayout
  title="CITX0001 Python Workshop Hub"
  description="Python workshop material connected to CITX0001 lecture concepts."
>
  <section class="surface-card-strong relative overflow-hidden rounded-[1.9rem] p-6 sm:p-8">
    <div class="absolute -right-10 -top-8 h-40 w-40 rounded-full bg-[var(--accent-soft)]/85 blur-2xl"></div>
    <div class="absolute -bottom-16 left-5 h-36 w-36 rounded-full bg-[var(--warm-soft)]/75 blur-2xl"></div>

    <div class="relative">
      <p class="kicker">Foundation Computing</p>
      <h1 class="mt-2 text-4xl font-bold sm:text-5xl">Python workshops for CITX0001 students</h1>
      <p class="mt-4 max-w-3xl text-base leading-7 text-[var(--ink-soft)] sm:text-lg">
        Follow hands-on tasks, runnable code, and practice challenges that line up with lecture concepts. This workshop stream starts at Week 02.
      </p>

      <div class="mt-6 flex flex-wrap gap-2">
        {firstWeek && (
          <a class="btn-primary" href={`/weeks/${firstWeek.id}/`}>
            Start {weekLabel(firstWeek)}
          </a>
        )}
        <a class="btn-secondary" href="/weeks/">Browse all workshops</a>
      </div>
    </div>
  </section>

  <section class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-2">
    <article class="surface-card rounded-2xl p-5">
      <p class="kicker">How to use this site</p>
      <h2 class="mt-2 text-2xl font-semibold">One week at a time</h2>
      <p class="mt-2 text-sm leading-6 text-[var(--ink-soft)]">
        Open the latest workshop, complete each exercise block, and use challenge prompts when you finish early.
      </p>
    </article>

    <article class="surface-card rounded-2xl p-5">
      <p class="kicker">Run Python quickly</p>
      <h2 class="mt-2 text-2xl font-semibold">No install needed</h2>
      <p class="mt-2 text-sm leading-6 text-[var(--ink-soft)]">
        Most tasks work in Google Colab, Replit, or W3Schools. Paste snippets and test results as you go.
      </p>
    </article>

  </section>

  <section class="mt-8">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-2xl font-semibold">Available workshops</h2>
      <a href="/weeks/" class="btn-secondary">Open workshop archive</a>
    </div>

    {weeks.length > 0 ? (
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {weeks.map((entry) => <WeekCard entry={entry} />)}
      </div>
    ) : (
      <div class="surface-card rounded-2xl p-5 text-sm text-[var(--ink-soft)]">
        No published workshops are available yet.
      </div>
    )}
  </section>
</BaseLayout>
