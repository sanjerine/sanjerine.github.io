---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Weekly Python workshops for CITX0001." } = Astro.props;

const navItems = [
  { href: "/", label: "Home" },
  { href: "/weeks/week-02a/", label: "Start Week 02" },
  { href: "/weeks/", label: "Workshop Archive" },
];

function isNavActive(href: string): boolean {
  if (href === "/") {
    return Astro.url.pathname === "/";
  }

  if (href === "/weeks/week-02a/") {
    return Astro.url.pathname === "/weeks/week-02a/";
  }

  if (href === "/weeks/") {
    return Astro.url.pathname.startsWith("/weeks/") && Astro.url.pathname !== "/weeks/week-02a/";
  }

  return Astro.url.pathname.startsWith(href);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💻</text></svg>" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="antialiased">
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
      <div class="page-glow absolute -left-28 -top-24 h-80 w-80 rounded-full bg-[#9dd5ec]/45 blur-3xl"></div>
      <div class="page-glow absolute right-[-5rem] top-44 h-[28rem] w-[28rem] rounded-full bg-[#f1bf9f]/35 blur-3xl"></div>
      <div class="paper-grid absolute inset-0 opacity-55"></div>
    </div>

    <div class="mx-auto flex min-h-screen w-full max-w-6xl flex-col px-4 pb-12 pt-7 sm:px-6 lg:px-8">
      <header class="surface-card-strong relative overflow-hidden rounded-[1.75rem] px-5 py-4 sm:px-6">
        <div class="absolute -right-10 -top-10 h-36 w-36 rounded-full bg-[var(--accent-soft)]/85 blur-2xl"></div>
        <div class="relative flex flex-wrap items-center justify-between gap-4">
          <a href="/" class="leading-tight no-underline">
            <p class="kicker">CITX0001</p>
            <p class="mt-1 text-[1.35rem] font-semibold text-[var(--ink)]">Python Workshop Hub</p>
          </a>

          <nav class="flex flex-wrap items-center gap-2">
            {navItems.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "rounded-full border px-3 py-1.5 text-sm transition",
                  isNavActive(item.href)
                    ? "border-[#6ea8c2] bg-[#d8edf8] text-[#0d5f81]"
                    : "border-[#cdbb9f] bg-white/65 text-[#566476] hover:border-[#78a9c1] hover:text-[#1a2a3d]",
                ]}
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      </header>

      <main class="motion-rise mt-8 flex-1">
        <slot />
      </main>

    </div>
  </body>
</html>
