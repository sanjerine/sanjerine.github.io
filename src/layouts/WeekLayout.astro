---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import { weekHref, weekLabel } from "../lib/weeks";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: CollectionEntry<"weeks">;
  headings?: Heading[];
  prev?: CollectionEntry<"weeks">;
  next?: CollectionEntry<"weeks">;
}

const { entry, headings = [], prev, next } = Astro.props;

const title = `${weekLabel(entry)}: ${entry.data.title}`;
const tocHeadings = headings.filter((heading) => heading.depth === 2);
const releaseDate = entry.data.releaseDate
  ? entry.data.releaseDate.toLocaleDateString("en-AU", {
      day: "2-digit",
      month: "short",
      year: "numeric",
    })
  : null;
---

<BaseLayout title={title} description={entry.data.summary}>
  <section class="rounded-3xl border border-slate-700/80 bg-slate-900/70 p-6 shadow-[0_18px_60px_-28px_rgba(15,23,42,0.8)] backdrop-blur sm:p-8">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-200">{entry.data.unitCode}</p>
    <h1 class="mt-2 text-3xl font-bold text-white sm:text-4xl">{title}</h1>
    <p class="mt-3 max-w-3xl text-base text-slate-200">{entry.data.summary}</p>

    <div class="mt-5 flex flex-wrap items-center gap-2 text-xs">
      <span class="rounded-full border border-blue-300/70 bg-blue-500/20 px-3 py-1 text-blue-100">
        {entry.data.published ? "Published" : "Coming Soon"}
      </span>
      {releaseDate && (
        <span class="rounded-full border border-slate-600/80 bg-slate-800/70 px-3 py-1 text-slate-200">
          Release: {releaseDate}
        </span>
      )}
      {entry.data.estimatedHours && (
        <span class="rounded-full border border-slate-600/80 bg-slate-800/70 px-3 py-1 text-slate-200">
          Approx. {entry.data.estimatedHours} hours
        </span>
      )}
    </div>

    {entry.data.learningOutcomes.length > 0 && (
      <div class="mt-6 rounded-2xl border border-slate-700/90 bg-slate-950/45 p-4">
        <h2 class="text-base font-semibold text-white">Learning outcomes</h2>
        <ul class="mt-3 space-y-1 text-sm text-slate-200">
          {entry.data.learningOutcomes.map((outcome) => (
            <li class="flex gap-2"><span class="mt-1 size-1.5 rounded-full bg-blue-300"></span><span>{outcome}</span></li>
          ))}
        </ul>
      </div>
    )}
  </section>

  <div class="mt-6 grid gap-5 lg:grid-cols-[minmax(0,1fr)_14rem]">
    <article class="rounded-3xl border border-slate-700/80 bg-slate-900/70 p-6 sm:p-8">
      <div class="prose workshop-prose prose-headings:scroll-mt-28 prose-code:rounded prose-code:bg-slate-800/80 prose-code:px-1.5 prose-code:py-0.5 prose-code:text-blue-100 prose-code:before:content-none prose-code:after:content-none prose-pre:border prose-pre:border-slate-700 prose-pre:bg-slate-950/80 prose-pre:shadow-none max-w-none">
        <slot />
      </div>
    </article>

    {tocHeadings.length > 0 && (
      <aside class="h-fit rounded-2xl border border-slate-700/80 bg-slate-900/70 p-4 text-sm text-slate-300 lg:sticky lg:top-6">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-200">On this page</p>
        <ul class="mt-3 space-y-2">
          {tocHeadings.map((heading) => (
            <li>
              <a class="text-slate-200 transition hover:text-blue-200" href={`#${heading.slug}`}>
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </div>

  <nav class="mt-6 grid gap-3 sm:grid-cols-3">
    <div>
      {prev ? (
        <a
          href={weekHref(prev)}
          class="block rounded-2xl border border-slate-700/80 bg-slate-900/70 px-4 py-3 text-sm text-slate-100 transition hover:border-blue-300/70 hover:text-white"
        >
          <span class="block text-xs uppercase tracking-[0.16em] text-slate-400">Previous</span>
          <span class="mt-1 block font-medium">{weekLabel(prev)}: {prev.data.title}</span>
        </a>
      ) : (
        <div class="rounded-2xl border border-slate-700/70 bg-slate-900/40 px-4 py-3 text-sm text-slate-500">No previous week</div>
      )}
    </div>

    <a
      href="/weeks/"
      class="flex items-center justify-center rounded-2xl border border-slate-700/80 bg-slate-900/70 px-4 py-3 text-sm font-medium text-slate-100 transition hover:border-blue-300/70 hover:text-white"
    >
      All weeks
    </a>

    <div>
      {next ? (
        <a
          href={weekHref(next)}
          class="block rounded-2xl border border-slate-700/80 bg-slate-900/70 px-4 py-3 text-sm text-slate-100 transition hover:border-blue-300/70 hover:text-white"
        >
          <span class="block text-xs uppercase tracking-[0.16em] text-slate-400">Next</span>
          <span class="mt-1 block font-medium">{weekLabel(next)}: {next.data.title}</span>
        </a>
      ) : (
        <div class="rounded-2xl border border-slate-700/70 bg-slate-900/40 px-4 py-3 text-sm text-slate-500">No next week</div>
      )}
    </div>
  </nav>
</BaseLayout>
