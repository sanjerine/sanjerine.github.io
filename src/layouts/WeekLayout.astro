---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import { weekHref, weekLabel } from "../lib/weeks";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: CollectionEntry<"weeks">;
  headings?: Heading[];
  prev?: CollectionEntry<"weeks">;
  next?: CollectionEntry<"weeks">;
}

const { entry, headings = [], prev, next } = Astro.props;

const title = `${weekLabel(entry)}: ${entry.data.title}`;
const tocHeadings = headings.filter((heading) => heading.depth === 2);
const releaseDate = entry.data.releaseDate
  ? entry.data.releaseDate.toLocaleDateString("en-AU", {
      day: "2-digit",
      month: "short",
      year: "numeric",
    })
  : null;
---

<BaseLayout title={title} description={entry.data.summary}>
  <section class="surface-card-strong relative overflow-hidden rounded-[1.9rem] p-6 sm:p-8">
    <div class="absolute -right-12 -top-12 h-40 w-40 rounded-full bg-[var(--accent-soft)]/80 blur-2xl"></div>
    <div class="absolute -bottom-16 left-10 h-36 w-36 rounded-full bg-[var(--warm-soft)]/70 blur-2xl"></div>

    <div class="relative grid gap-6 lg:grid-cols-[minmax(0,1fr)_15rem] lg:items-start">
      <div>
        <p class="kicker">{entry.data.unitCode}</p>
        <h1 class="mt-2 text-3xl font-bold sm:text-4xl">{title}</h1>
        <p class="mt-3 max-w-3xl text-base text-[var(--ink-soft)]">{entry.data.summary}</p>

        <div class="mt-5 flex flex-wrap items-center gap-2 text-xs">
          <span class="rounded-full border border-[#8cb2c6] bg-[#def0f8] px-3 py-1 font-medium text-[#0d6286]">
            {entry.data.published ? "Published" : "Coming soon"}
          </span>
          {releaseDate && <span class="chip">Release: {releaseDate}</span>}
          {entry.data.estimatedHours && <span class="chip">Approx. {entry.data.estimatedHours} hours</span>}
        </div>
      </div>

      <div class="rounded-2xl border border-[#d1c0a6] bg-white/78 p-4 text-sm text-[#4f5f72]">
        <p class="kicker">At a glance</p>
        <ul class="mt-3 space-y-2">
          <li>Week number: {entry.data.week}{entry.data.part ?? ""}</li>
          <li>Content type: Python workshop</li>
          <li>Format: Guided practice and exercises</li>
        </ul>
      </div>
    </div>

    {entry.data.learningOutcomes.length > 0 && (
      <div class="relative mt-6 rounded-2xl border border-[#d1c2aa] bg-white/75 p-4">
        <h2 class="text-base font-semibold text-[var(--ink)]">Learning outcomes</h2>
        <ul class="mt-3 space-y-1 text-sm text-[var(--ink-soft)]">
          {entry.data.learningOutcomes.map((outcome) => (
            <li class="flex gap-2"><span class="mt-1 size-1.5 rounded-full bg-[#0d668d]"></span><span>{outcome}</span></li>
          ))}
        </ul>
      </div>
    )}
  </section>

  <div class="mt-6 grid gap-5 lg:grid-cols-[minmax(0,1fr)_15rem]">
    <article class="surface-card rounded-[1.7rem] p-6 sm:p-8">
      <div class="prose workshop-prose prose-headings:scroll-mt-28 max-w-none">
        <slot />
      </div>
    </article>

    {tocHeadings.length > 0 && (
      <aside class="surface-card h-fit rounded-2xl p-4 text-sm text-[#4f5f72] lg:sticky lg:top-6">
        <p class="kicker">On this page</p>
        <ul class="mt-3 space-y-2">
          {tocHeadings.map((heading) => (
            <li>
              <a class="text-[#2f435a] transition hover:text-[#0d6286]" href={`#${heading.slug}`}>
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </div>

  <nav class="mt-8">
    <div class="mb-4 h-px bg-gradient-to-r from-transparent via-[var(--line)] to-transparent"></div>

    <div class:list={[
      "flex gap-3",
      !prev && next ? "justify-end" : "",
      prev && !next ? "justify-start" : "",
      prev && next ? "justify-between" : "",
    ]}>
      {prev && (
        <a href={weekHref(prev)} class="week-nav-link group flex items-center gap-3 sm:max-w-[50%]">
          <span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-[var(--line)] bg-white/60 text-[var(--ink-soft)] transition group-hover:border-[var(--accent)] group-hover:bg-[var(--accent-soft)] group-hover:text-[var(--accent)]">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span class="min-w-0">
            <span class="block text-xs font-semibold uppercase tracking-[0.14em] text-[var(--ink-soft)]">Previous</span>
            <span class="mt-0.5 block truncate text-sm font-medium text-[var(--ink)]">{weekLabel(prev)}: {prev.data.title}</span>
          </span>
        </a>
      )}
      {next && (
        <a href={weekHref(next)} class="week-nav-link group flex items-center gap-3 text-right sm:max-w-[50%]">
          <span class="min-w-0">
            <span class="block text-xs font-semibold uppercase tracking-[0.14em] text-[var(--ink-soft)]">Next</span>
            <span class="mt-0.5 block truncate text-sm font-medium text-[var(--ink)]">{weekLabel(next)}: {next.data.title}</span>
          </span>
          <span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-[var(--line)] bg-white/60 text-[var(--ink-soft)] transition group-hover:border-[var(--accent)] group-hover:bg-[var(--accent-soft)] group-hover:text-[var(--accent)]">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      )}
    </div>

    <div class="mt-3 text-center">
      <a href="/weeks/" class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium text-[var(--ink-soft)] transition hover:bg-white/50 hover:text-[var(--accent)]">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        All weeks
      </a>
    </div>
  </nav>
</BaseLayout>
