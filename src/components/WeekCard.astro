---
import type { CollectionEntry } from "astro:content";
import { weekHref, weekLabel } from "../lib/weeks";

interface Props {
  entry: CollectionEntry<"weeks">;
}

const { entry } = Astro.props;
const href = weekHref(entry);
const releaseDate = entry.data.releaseDate
  ? entry.data.releaseDate.toLocaleDateString("en-AU", {
      day: "2-digit",
      month: "short",
      year: "numeric",
    })
  : null;
---

<article class="flex h-full flex-col rounded-2xl border border-slate-700/80 bg-slate-900/70 p-5 shadow-[0_12px_45px_-24px_rgba(0,0,0,0.75)]">
  <div class="flex items-center justify-between gap-2">
    <p class="text-sm font-semibold text-blue-200">{weekLabel(entry)}</p>
    <span
      class:list={[
        "rounded-full border px-2.5 py-1 text-xs",
        entry.data.published
          ? "border-emerald-300/70 bg-emerald-500/15 text-emerald-100"
          : "border-amber-300/70 bg-amber-400/15 text-amber-100",
      ]}
    >
      {entry.data.published ? "Published" : "Coming soon"}
    </span>
  </div>

  <h2 class="mt-3 text-xl font-semibold text-white">{entry.data.title}</h2>
  <p class="mt-2 flex-1 text-sm leading-6 text-slate-200">{entry.data.summary}</p>

  <div class="mt-4 flex items-center justify-between text-xs text-slate-300">
    <span>{entry.data.estimatedHours ? `${entry.data.estimatedHours}h workload` : "Self-paced"}</span>
    {releaseDate && <span>{releaseDate}</span>}
  </div>

  <div class="mt-4">
    {entry.data.published ? (
      <a
        href={href}
        class="inline-flex items-center gap-2 rounded-full border border-blue-300/70 bg-blue-500/20 px-3 py-1.5 text-sm font-medium text-blue-100 transition hover:border-blue-200 hover:bg-blue-500/30"
      >
        Open workshop
      </a>
    ) : (
      <span class="inline-flex items-center gap-2 rounded-full border border-slate-600/80 bg-slate-800/70 px-3 py-1.5 text-sm text-slate-300">
        Not yet released
      </span>
    )}
  </div>
</article>
