---
import type { CollectionEntry } from "astro:content";
import { weekHref, weekLabel } from "../lib/weeks";

interface Props {
  entry: CollectionEntry<"weeks">;
}

const { entry } = Astro.props;
const href = weekHref(entry);
const releaseDate = entry.data.releaseDate
  ? entry.data.releaseDate.toLocaleDateString("en-AU", {
      day: "2-digit",
      month: "short",
      year: "numeric",
    })
  : null;
---

<article class="surface-card group flex h-full flex-col rounded-[1.35rem] p-5 transition duration-200 hover:-translate-y-1 hover:shadow-[0_20px_34px_-28px_rgba(22,35,52,0.75)]">
  <div class="flex items-center justify-between gap-2">
    <p class="kicker">{weekLabel(entry)}</p>
    <span
      class:list={[
        "rounded-full border px-2.5 py-1 text-xs font-medium",
        entry.data.published
          ? "border-[#8cb3c7] bg-[#dff0f8] text-[#0d6286]"
          : "border-[#e4c29f] bg-[#fbecdf] text-[#9d4f24]",
      ]}
    >
      {entry.data.published ? "Published" : "Coming soon"}
    </span>
  </div>

  <h2 class="mt-3 text-2xl font-semibold leading-tight text-[var(--ink)]">{entry.data.title}</h2>
  <p class="mt-2 flex-1 text-sm leading-6 text-[var(--ink-soft)]">{entry.data.summary}</p>

  <div class="mt-4 flex items-center justify-between text-xs text-[#5d6b7c]">
    <span>Self-paced</span>
    {releaseDate && <span>{releaseDate}</span>}
  </div>

  <div class="mt-4">
    {entry.data.published ? (
      <a href={href} class="btn-primary">
        Open workshop
        <span aria-hidden="true">-></span>
      </a>
    ) : (
      <span class="inline-flex items-center gap-2 rounded-full border border-[#d6c4ab] bg-white/75 px-3 py-1.5 text-sm text-[#5a6878]">
        Not yet released
      </span>
    )}
  </div>
</article>
