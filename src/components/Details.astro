---
interface Props {
  summary: string;
}

const { summary } = Astro.props;
---

<details class="hint-block my-6 rounded-2xl border border-[#c0b4d0] bg-[#f4eff9] px-4 py-4 shadow-[0_10px_24px_-24px_rgba(18,28,39,0.7)] sm:px-5">
  <summary class="cursor-pointer text-lg font-semibold text-[#5a3d7a] select-none flex items-center gap-2">
    <svg class="hint-chevron size-4 shrink-0" viewBox="0 0 16 16" fill="none">
      <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    {summary}
  </summary>
  <div class="mt-3 text-sm text-[#2f3d4f] [&_code]:rounded [&_code]:bg-[#f7f9ff] [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:text-[#134766] [&_li]:my-1.5">
    <slot />
  </div>
</details>
